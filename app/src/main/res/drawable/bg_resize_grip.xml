<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item
        android:gravity="bottom|right"
        android:right="2dp"
        android:bottom="2dp">
        <shape android:shape="oval">
            <solid android:color="#8CFFFFFF" />
            <size
                android:width="7dp"
                android:height="7dp" />
        </shape>
    </item>
    <item
        android:gravity="bottom|right"
        android:right="10dp"
        android:bottom="2dp">
        <shape android:shape="oval">
            <solid android:color="#8CFFFFFF" />
            <size
                android:width="7dp"
                android:height="7dp" />
        </shape>
    </item>
    <item
        android:gravity="bottom|right"
        android:right="2dp"
        android:bottom="10dp">
        <shape android:shape="oval">
            <solid android:color="#8CFFFFFF" />
            <size
                android:width="7dp"
                android:height="7dp" />
        </shape>
    </item>
</layer-list>
