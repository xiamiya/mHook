<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_home_gradient"
    android:orientation="vertical">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingLeft="12dp"
        android:paddingRight="20dp"
        android:paddingTop="24dp"
        android:paddingBottom="8dp">

        <ImageView
            android:id="@+id/btn_back"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:clickable="true"
            android:focusable="true"
            android:foreground="?android:attr/selectableItemBackgroundBorderless"
            android:padding="8dp"
            android:src="@drawable/ic_back"
            android:tint="@color/glass_text_primary" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginLeft="8dp"
            android:text="Native 调试"
            android:textColor="@color/glass_text_primary"
            android:textSize="20sp"
            android:textStyle="bold" />
    </LinearLayout>

    <ScrollView
        android:id="@+id/scroll_log"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:paddingLeft="20dp"
        android:paddingRight="20dp"
        android:paddingBottom="24dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <FrameLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:background="@drawable/bg_glass_card"
                android:padding="14dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="目标应用"
                        android:textColor="@color/glass_text_secondary"
                        android:textSize="12sp" />

                    <TextView
                        android:id="@+id/tv_target"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:ellipsize="end"
                        android:maxLines="1"
                        android:textColor="@color/glass_accent_cyan"
                        android:textSize="15sp"
                        android:textStyle="bold" />
                </LinearLayout>
            </FrameLayout>

            <FrameLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:background="@drawable/bg_glass_card"
                android:paddingLeft="16dp"
                android:paddingRight="16dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:paddingTop="14dp"
                    android:paddingBottom="14dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Native 工具"
                        android:textColor="@color/glass_text_primary"
                        android:textSize="14sp"
                        android:textStyle="bold" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="2dp"
                        android:text="选操作自动生成脚本，可编辑后注入"
                        android:textColor="@color/glass_text_tertiary"
                        android:textSize="11sp" />

                    <EditText
                        android:id="@+id/et_module"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="6dp"
                        android:background="@android:color/transparent"
                        android:hint="模块名，如 libc.so"
                        android:inputType="text"
                        android:textColor="@color/glass_text_primary"
                        android:textColorHint="@color/glass_text_tertiary"
                        android:textSize="14sp" />

                    <EditText
                        android:id="@+id/et_symbol"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:background="@android:color/transparent"
                        android:hint="符号名，或偏移 0x1a2b0"
                        android:inputType="text"
                        android:textColor="@color/glass_text_primary"
                        android:textColorHint="@color/glass_text_tertiary"
                        android:textSize="14sp" />

                    <EditText
                        android:id="@+id/et_scan"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:background="@android:color/transparent"
                        android:hint="内存搜索关键字（字符串）"
                        android:inputType="text"
                        android:textColor="@color/glass_text_primary"
                        android:textColorHint="@color/glass_text_tertiary"
                        android:textSize="14sp" />

                    <EditText
                        android:id="@+id/et_size"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:background="@android:color/transparent"
                        android:hint="Dump 长度，如 0x1000"
                        android:inputType="text"
                        android:textColor="@color/glass_text_primary"
                        android:textColorHint="@color/glass_text_tertiary"
                        android:textSize="14sp" />

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="6dp"
                        android:orientation="horizontal">

                        <TextView
                            android:id="@+id/btn_modules"
                            android:layout_width="0dp"
                            android:layout_height="40dp"
                            android:layout_weight="1"
                            android:layout_marginRight="4dp"
                            android:background="@drawable/bg_glass_btn"
                            android:clickable="true"
                            android:focusable="true"
                            android:gravity="center"
                            android:text="列出模块"
                            android:textColor="@color/glass_accent_cyan"
                            android:textSize="12sp"
                            android:textStyle="bold" />

                        <TextView
                            android:id="@+id/btn_exports"
                            android:layout_width="0dp"
                            android:layout_height="40dp"
                            android:layout_weight="1"
                            android:layout_marginLeft="4dp"
                            android:background="@drawable/bg_glass_btn"
                            android:clickable="true"
                            android:focusable="true"
                            android:gravity="center"
                            android:text="导出符号"
                            android:textColor="@color/glass_accent_cyan"
                            android:textSize="12sp"
                            android:textStyle="bold" />
                    </LinearLayout>

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="6dp"
                        android:orientation="horizontal">

                        <TextView
                            android:id="@+id/btn_hook_sym"
                            android:layout_width="0dp"
                            android:layout_height="40dp"
                            android:layout_weight="1"
                            android:layout_marginRight="4dp"
                            android:background="@drawable/bg_glass_btn"
                            android:clickable="true"
                            android:focusable="true"
                            android:gravity="center"
                            android:text="Hook 符号"
                            android:textColor="@color/glass_accent_green"
                            android:textSize="12sp"
                            android:textStyle="bold" />

                        <TextView
                            android:id="@+id/btn_hook_off"
                            android:layout_width="0dp"
                            android:layout_height="40dp"
                            android:layout_weight="1"
                            android:layout_marginLeft="4dp"
                            android:background="@drawable/bg_glass_btn"
                            android:clickable="true"
                            android:focusable="true"
                            android:gravity="center"
                            android:text="Hook 偏移"
                            android:textColor="@color/glass_accent_green"
                            android:textSize="12sp"
                            android:textStyle="bold" />
                    </LinearLayout>

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="6dp"
                        android:orientation="horizontal">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="6dp"
                        android:orientation="horizontal">

                        <TextView
                            android:id="@+id/btn_hex"
                            android:layout_width="0dp"
                            android:layout_height="40dp"
                            android:layout_weight="1"
                            android:layout_marginRight="4dp"
                            android:background="@drawable/bg_glass_btn"
                            android:clickable="true"
                            android:focusable="true"
                            android:gravity="center"
                            android:text="Hex 查看"
                            android:textColor="@color/glass_accent_cyan"
                            android:textSize="12sp"
                            android:textStyle="bold" />

                        <TextView
                            android:id="@+id/btn_export_json"
                            android:layout_width="0dp"
                            android:layout_height="40dp"
                            android:layout_weight="1"
                            android:layout_marginLeft="4dp"
                            android:layout_marginRight="4dp"
                            android:background="@drawable/bg_glass_btn"
                            android:clickable="true"
                            android:focusable="true"
                            android:gravity="center"
                            android:text="导出JSON"
                            android:textColor="@color/glass_accent_green"
                            android:textSize="12sp"
                            android:textStyle="bold" />

                        <TextView
                            android:id="@+id/btn_memdiff"
                            android:layout_width="0dp"
                            android:layout_height="40dp"
                            android:layout_weight="1"
                            android:layout_marginLeft="4dp"
                            android:background="@drawable/bg_glass_btn"
                            android:clickable="true"
                            android:focusable="true"
                            android:gravity="center"
                            android:text="内存对比"
                            android:textColor="@color/glass_accent_orange"
                            android:textSize="12sp"
                            android:textStyle="bold" />
                    </LinearLayout>

                    <TextView
                        android:id="@+id/btn_calls"
                        android:layout_width="match_parent"
                        android:layout_height="40dp"
                        android:layout_marginTop="6dp"
                        android:background="@drawable/bg_glass_btn"
                        android:clickable="true"
                        android:focusable="true"
                        android:gravity="center"
                        android:text="BL/BR 调用捕获（Stalker trace 模块+符号）"
                        android:textColor="@color/glass_accent_orange"
                        android:textSize="12sp"
                        android:textStyle="bold" />

                    <TextView
                            android:id="@+id/btn_scan"
                            android:layout_width="0dp"
                            android:layout_height="40dp"
                            android:layout_weight="1"
                            android:layout_marginRight="4dp"
                            android:background="@drawable/bg_glass_btn"
                            android:clickable="true"
                            android:focusable="true"
                            android:gravity="center"
                            android:text="内存搜索"
                            android:textColor="@color/glass_accent_cyan"
                            android:textSize="12sp"
                            android:textStyle="bold" />

                        <TextView
                            android:id="@+id/btn_bypass"
                            android:layout_width="0dp"
                            android:layout_height="40dp"
                            android:layout_weight="1"
                            android:layout_marginLeft="4dp"
                            android:background="@drawable/bg_glass_btn"
                            android:clickable="true"
                            android:focusable="true"
                            android:gravity="center"
                            android:text="反调试绕过"
                            android:textColor="@color/glass_accent_red"
                            android:textSize="12sp"
                            android:textStyle="bold" />
                    </LinearLayout>

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="6dp"
                        android:orientation="horizontal">

                        <TextView
                            android:id="@+id/btn_dump"
                            android:layout_width="0dp"
                            android:layout_height="40dp"
                            android:layout_weight="1"
                            android:layout_marginRight="4dp"
                            android:background="@drawable/bg_glass_btn"
                            android:clickable="true"
                            android:focusable="true"
                            android:gravity="center"
                            android:text="Dump 内存"
                            android:textColor="@color/glass_accent_orange"
                            android:textSize="12sp"
                            android:textStyle="bold" />

                        <TextView
                            android:id="@+id/btn_write"
                            android:layout_width="0dp"
                            android:layout_height="40dp"
                            android:layout_weight="1"
                            android:layout_marginLeft="4dp"
                            android:layout_marginRight="4dp"
                            android:background="@drawable/bg_glass_btn"
                            android:clickable="true"
                            android:focusable="true"
                            android:gravity="center"
                            android:text="写入内存"
                            android:textColor="@color/glass_accent_red"
                            android:textSize="12sp"
                            android:textStyle="bold" />

                        <TextView
                            android:id="@+id/btn_export_dump"
                            android:layout_width="0dp"
                            android:layout_height="40dp"
                            android:layout_weight="1"
                            android:layout_marginLeft="4dp"
                            android:background="@drawable/bg_glass_btn"
                            android:clickable="true"
                            android:focusable="true"
                            android:gravity="center"
                            android:text="导出Dump"
                            android:textColor="@color/glass_accent_green"
                            android:textSize="12sp"
                            android:textStyle="bold" />
                    </LinearLayout>

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="6dp"
                        android:orientation="horizontal">

                        <TextView
                            android:id="@+id/btn_jdwp_on"
                            android:layout_width="0dp"
                            android:layout_height="40dp"
                            android:layout_weight="1"
                            android:layout_marginRight="4dp"
                            android:background="@drawable/bg_glass_btn"
                            android:clickable="true"
                            android:focusable="true"
                            android:gravity="center"
                            android:text="开启JDWP"
                            android:textColor="@color/glass_accent_cyan"
                            android:textSize="12sp"
                            android:textStyle="bold" />

                        <TextView
                            android:id="@+id/btn_jdwp_off"
                            android:layout_width="0dp"
                            android:layout_height="40dp"
                            android:layout_weight="1"
                            android:layout_marginLeft="4dp"
                            android:background="@drawable/bg_glass_btn"
                            android:clickable="true"
                            android:focusable="true"
                            android:gravity="center"
                            android:text="关闭JDWP"
                            android:textColor="@color/glass_text_secondary"
                            android:textSize="12sp"
                            android:textStyle="bold" />
                    </LinearLayout>

                    <TextView
                        android:id="@+id/btn_dex_zip"
                        android:layout_width="match_parent"
                        android:layout_height="42dp"
                        android:layout_marginTop="6dp"
                        android:background="@drawable/bg_glass_btn"
                        android:clickable="true"
                        android:focusable="true"
                        android:gravity="center"
                        android:text="一键动态分析导出DEX（自动重启App + 打包zip）"
                        android:textColor="@color/glass_accent_green"
                        android:textSize="12sp"
                        android:textStyle="bold" />
                </LinearLayout>
            </FrameLayout>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="18dp"
                android:layout_marginBottom="8dp"
                android:text="脚本（可编辑后注入）"
                android:textColor="@color/glass_text_secondary"
                android:textSize="12sp" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="6dp"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/btn_import_script"
                    android:layout_width="wrap_content"
                    android:layout_height="30dp"
                    android:background="@drawable/bg_glass_btn"
                    android:clickable="true"
                    android:focusable="true"
                    android:gravity="center"
                    android:paddingLeft="14dp"
                    android:paddingRight="14dp"
                    android:text="导入文件"
                    android:textColor="@color/glass_accent_green"
                    android:textSize="12sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/btn_paste_script"
                    android:layout_width="wrap_content"
                    android:layout_height="30dp"
                    android:layout_marginLeft="8dp"
                    android:background="@drawable/bg_glass_btn"
                    android:clickable="true"
                    android:focusable="true"
                    android:gravity="center"
                    android:paddingLeft="14dp"
                    android:paddingRight="14dp"
                    android:text="粘贴脚本"
                    android:textColor="@color/glass_accent_cyan"
                    android:textSize="12sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/btn_clear_script"
                    android:layout_width="wrap_content"
                    android:layout_height="30dp"
                    android:layout_marginLeft="8dp"
                    android:background="@drawable/bg_glass_btn"
                    android:clickable="true"
                    android:focusable="true"
                    android:gravity="center"
                    android:paddingLeft="14dp"
                    android:paddingRight="14dp"
                    android:text="清空"
                    android:textColor="@color/glass_accent_red"
                    android:textSize="12sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/tv_script_len"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:layout_marginLeft="10dp"
                    android:gravity="right|center_vertical"
                    android:text="0 字符"
                    android:textColor="@color/glass_text_secondary"
                    android:textSize="11sp" />
            </LinearLayout>

            <EditText
                android:id="@+id/et_script"
                android:layout_width="match_parent"
                android:layout_height="240dp"
                android:background="@drawable/bg_glass_card"
                android:gravity="top|start"
                android:inputType="textMultiLine"
                android:padding="12dp"
                android:scrollbars="vertical"
                android:textColor="@color/glass_text_primary"
                android:textSize="11sp"
                android:typeface="monospace" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/btn_inject"
                    android:layout_width="0dp"
                    android:layout_height="44dp"
                    android:layout_weight="1"
                    android:layout_marginRight="4dp"
                    android:background="@drawable/bg_glass_btn"
                    android:clickable="true"
                    android:focusable="true"
                    android:gravity="center"
                    android:text="注入并运行"
                    android:textColor="@color/glass_accent_green"
                    android:textSize="13sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/btn_uninject"
                    android:layout_width="0dp"
                    android:layout_height="44dp"
                    android:layout_weight="1"
                    android:layout_marginLeft="4dp"
                    android:layout_marginRight="4dp"
                    android:background="@drawable/bg_glass_btn"
                    android:clickable="true"
                    android:focusable="true"
                    android:gravity="center"
                    android:text="取消注入"
                    android:textColor="@color/glass_accent_red"
                    android:textSize="13sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/btn_readout"
                    android:layout_width="0dp"
                    android:layout_height="44dp"
                    android:layout_weight="1"
                    android:layout_marginLeft="4dp"
                    android:background="@drawable/bg_glass_btn"
                    android:clickable="true"
                    android:focusable="true"
                    android:gravity="center"
                    android:text="刷新输出"
                    android:textColor="@color/glass_accent_cyan"
                    android:textSize="13sp"
                    android:textStyle="bold" />
            </LinearLayout>

            <EditText
                android:id="@+id/et_filter"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="18dp"
                android:background="@drawable/bg_glass_btn"
                android:hint="输出过滤（关键字，留空显示全部）"
                android:inputType="text"
                android:padding="10dp"
                android:textColor="@color/glass_text_primary"
                android:textColorHint="@color/glass_text_tertiary"
                android:textSize="13sp" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/btn_mode_all"
                    android:layout_width="0dp"
                    android:layout_height="34dp"
                    android:layout_weight="1"
                    android:layout_marginRight="3dp"
                    android:background="@drawable/bg_glass_btn"
                    android:clickable="true"
                    android:focusable="true"
                    android:gravity="center"
                    android:text="全部"
                    android:textColor="@color/glass_accent_cyan"
                    android:textSize="12sp" />

                <TextView
                    android:id="@+id/btn_mode_call"
                    android:layout_width="0dp"
                    android:layout_height="34dp"
                    android:layout_weight="1"
                    android:layout_marginLeft="3dp"
                    android:layout_marginRight="3dp"
                    android:background="@drawable/bg_glass_btn"
                    android:clickable="true"
                    android:focusable="true"
                    android:gravity="center"
                    android:text="调用"
                    android:textColor="@color/glass_text_secondary"
                    android:textSize="12sp" />

                <TextView
                    android:id="@+id/btn_mode_return"
                    android:layout_width="0dp"
                    android:layout_height="34dp"
                    android:layout_weight="1"
                    android:layout_marginLeft="3dp"
                    android:layout_marginRight="3dp"
                    android:background="@drawable/bg_glass_btn"
                    android:clickable="true"
                    android:focusable="true"
                    android:gravity="center"
                    android:text="返回"
                    android:textColor="@color/glass_text_secondary"
                    android:textSize="12sp" />

                <TextView
                    android:id="@+id/btn_mode_error"
                    android:layout_width="0dp"
                    android:layout_height="34dp"
                    android:layout_weight="1"
                    android:layout_marginLeft="3dp"
                    android:background="@drawable/bg_glass_btn"
                    android:clickable="true"
                    android:focusable="true"
                    android:gravity="center"
                    android:text="错误"
                    android:textColor="@color/glass_text_secondary"
                    android:textSize="12sp" />
            </LinearLayout>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:layout_marginBottom="8dp"
                android:text="输出"
                android:textColor="@color/glass_text_secondary"
                android:textSize="12sp" />

            <ScrollView
                android:id="@+id/scroll_out"
                android:layout_width="match_parent"
                android:layout_height="240dp"
                android:background="@drawable/bg_glass_card"
                android:padding="12dp">

                <TextView
                    android:id="@+id/tv_out"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:textColor="@color/glass_accent_cyan"
                    android:textSize="11sp"
                    android:typeface="monospace" />
            </ScrollView>
        </LinearLayout>
    </ScrollView>
</LinearLayout>
