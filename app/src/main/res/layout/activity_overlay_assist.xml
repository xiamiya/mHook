<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_home_gradient"
    android:orientation="vertical">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingLeft="12dp"
        android:paddingTop="24dp"
        android:paddingRight="20dp"
        android:paddingBottom="8dp">

        <ImageView
            android:id="@+id/btn_back"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:clickable="true"
            android:focusable="true"
            android:padding="8dp"
            android:src="@drawable/ic_back"
            android:tint="@color/glass_text_primary" />

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginLeft="8dp"
            android:ellipsize="end"
            android:maxLines="1"
            android:text="屏幕叠加辅助（实验）"
            android:textColor="@color/glass_text_primary"
            android:textSize="20sp"
            android:textStyle="bold" />
    </LinearLayout>

    <TextView
        android:id="@+id/oa_status"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginLeft="20dp"
        android:layout_marginRight="20dp"
        android:text="状态加载中…"
        android:textColor="@color/glass_text_tertiary"
        android:textSize="13sp" />

    <TextView
        android:id="@+id/oa_btn_accessibility"
        android:layout_width="match_parent"
        android:layout_height="44dp"
        android:layout_marginLeft="16dp"
        android:layout_marginTop="12dp"
        android:layout_marginRight="16dp"
        android:background="@drawable/bg_glass_btn"
        android:gravity="center"
        android:text="1. 开启无障碍服务"
        android:textColor="@color/glass_text_primary"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/oa_btn_overlay"
        android:layout_width="match_parent"
        android:layout_height="44dp"
        android:layout_marginLeft="16dp"
        android:layout_marginTop="8dp"
        android:layout_marginRight="16dp"
        android:background="@drawable/bg_glass_btn"
        android:gravity="center"
        android:text="2. 授权悬浮窗权限"
        android:textColor="@color/glass_text_primary"
        android:textStyle="bold" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="44dp"
        android:layout_marginLeft="16dp"
        android:layout_marginTop="8dp"
        android:layout_marginRight="16dp"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/oa_btn_start"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:background="@drawable/bg_glass_btn"
            android:gravity="center"
            android:text="3. 开始"
            android:textColor="@color/glass_text_primary"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/oa_btn_stop"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:layout_marginLeft="8dp"
            android:background="@drawable/bg_glass_btn"
            android:gravity="center"
            android:text="停止"
            android:textColor="@color/glass_text_primary"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/oa_btn_clear"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:layout_marginLeft="8dp"
            android:background="@drawable/bg_glass_btn"
            android:gravity="center"
            android:text="清空"
            android:textColor="@color/glass_text_primary"
            android:textStyle="bold" />
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginLeft="16dp"
        android:layout_marginTop="10dp"
        android:layout_marginRight="16dp"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="亮度阈值"
            android:textColor="@color/glass_text_tertiary"
            android:textSize="13sp" />

        <TextView
            android:id="@+id/oa_thr_minus"
            android:layout_width="40dp"
            android:layout_height="34dp"
            android:background="@drawable/bg_glass_btn"
            android:gravity="center"
            android:text="－"
            android:textColor="@color/glass_text_primary" />

        <TextView
            android:id="@+id/oa_threshold"
            android:layout_width="56dp"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:text="150"
            android:textColor="@color/glass_text_primary" />

        <TextView
            android:id="@+id/oa_thr_plus"
            android:layout_width="40dp"
            android:layout_height="34dp"
            android:background="@drawable/bg_glass_btn"
            android:gravity="center"
            android:text="＋"
            android:textColor="@color/glass_text_primary" />

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginLeft="16dp"
            android:text="最大长度"
            android:textColor="@color/glass_text_tertiary"
            android:textSize="13sp" />

        <TextView
            android:id="@+id/oa_len_minus"
            android:layout_width="40dp"
            android:layout_height="34dp"
            android:background="@drawable/bg_glass_btn"
            android:gravity="center"
            android:text="－"
            android:textColor="@color/glass_text_primary" />

        <TextView
            android:id="@+id/oa_maxlen"
            android:layout_width="56dp"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:text="900"
            android:textColor="@color/glass_text_primary" />

        <TextView
            android:id="@+id/oa_len_plus"
            android:layout_width="40dp"
            android:layout_height="34dp"
            android:background="@drawable/bg_glass_btn"
            android:gravity="center"
            android:text="＋"
            android:textColor="@color/glass_text_primary" />
    </LinearLayout>

    <ScrollView
        android:id="@+id/oa_log_scroll"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_marginTop="12dp"
        android:layout_weight="1">

        <TextView
            android:id="@+id/oa_log"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginLeft="20dp"
            android:layout_marginRight="20dp"
            android:fontFamily="monospace"
            android:textColor="#BFFFFFFF"
            android:textSize="12sp" />
    </ScrollView>

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_margin="12dp"
        android:gravity="center"
        android:text="说明：本页用于个人设备上的屏幕辅助（不修改任何第三方应用）。\n需要「无障碍 + 悬浮窗」权限；亮度阈值/最大长度可现场调参。"
        android:textColor="@color/glass_text_tertiary"
        android:textSize="12sp" />

</LinearLayout>
